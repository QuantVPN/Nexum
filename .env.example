# Copy to .env for local development. Every value is optional; these are the defaults.
NEXUM_ENVIRONMENT=development          # development | test | production
NEXUM_DEBUG=false
NEXUM_DATABASE_URL=sqlite:///./nexum.db # or postgresql+psycopg://user:pass@host:5432/nexum
NEXUM_SECRET_KEY=change-me-in-production   # signs session cookies; use `openssl rand -hex 32`
NEXUM_SESSION_MAX_AGE_SECONDS=43200

# Automation engine
NEXUM_AUTOMATION_ENABLED=true          # background ticker for scheduled rules
NEXUM_AUTOMATION_TICK_SECONDS=30
NEXUM_AUTOMATION_WEBHOOKS_ENABLED=false # allow the `webhook` action to make outbound HTTP calls

# Payroll defaults
NEXUM_DEFAULT_CURRENCY=SEK
NEXUM_WEEKLY_OVERTIME_THRESHOLD_HOURS=40
NEXUM_OVERTIME_MULTIPLIER=1.5
